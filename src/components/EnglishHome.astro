---
import Layout from '../layouts/Layout.astro';
import { profile, skills, projects, copy, experience } from '../content/site';
const featured = projects.filter(project => project.featured);
const lead = featured[0];
const supporting = featured.slice(1);
const archive = projects.filter(project => !project.featured);
const skillItems = Object.values(skills).flat();
const marqueeItems = [...skillItems.slice(0, 8), ...skills['AI / Machine Learning'].slice(0, 8)];
---
<Layout locale="en">
  <header class="hero" id="profile">
    <div class="hero-sticker">Open to full-time roles in Saudi Arabia.</div>
    <h1><span class="name-tag">{profile.name.split(' ')[0]}</span></h1>
    <p>Full-Stack &amp; AI/ML Developer</p>
    <p class="sub">{copy.en.summary}</p>
    <div class="hero-actions"><a class="btn" href={`mailto:${profile.email}`}>Email me</a><a class="btn" href={profile.cv} download>{copy.en.download}</a><a class="btn" href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a></div>
  </header>

  <div class="mq" aria-label="Technical skills"><div>{marqueeItems.join(' ★ ')} ★ {marqueeItems.join(' ★ ')} ★ </div></div>

  <section id="projects"><h2>Selected <mark>work</mark></h2>
    {lead && <article class="card feat"><div class="num">01</div><div><span class="tag">{lead.eyebrow}</span><h3>{lead.title}</h3><p>{lead.description}</p><div class="chips">{lead.stack.map(item => <span>{item}</span>)}</div><div class="card-links"><a href={`/en/projects/${lead.slug}`}>Open case file ↗</a><a href={lead.repo} target="_blank" rel="noreferrer">GitHub ↗</a>{lead.demo && <a href={lead.demo} target="_blank" rel="noreferrer">Live demo ↗</a>}</div></div></article>}
    <div class="grid3 featured-grid">{supporting.map((project, index) => <article class="card project-block"><div class="project-number">0{index + 2}</div><span class="tag">{project.eyebrow}</span><h3>{project.title}</h3><p>{project.description}</p><div class="chips">{project.stack.map(item => <span>{item}</span>)}</div><div class="card-links"><a href={`/en/projects/${project.slug}`}>Open case file ↗</a><a href={project.repo} target="_blank" rel="noreferrer">GitHub ↗</a></div></article>)}</div>
    <h2 class="archive-title">Project <mark>archive</mark></h2><div class="grid3 archive-grid">{archive.map(project => <article class="card project-block"><span class="tag">{project.eyebrow}</span><h3>{project.title}</h3><p>{project.description}</p><div class="chips">{project.stack.map(item => <span>{item}</span>)}</div>{project.result && <p class="result"><strong>Result:</strong> {project.result}</p>}<div class="card-links"><a href={project.repo} target="_blank" rel="noreferrer">GitHub ↗</a></div></article>)}</div>
  </section>

  <section id="experience"><h2>Experience <mark>&amp; education</mark></h2><div class="about"><article class="card about-primary"><span class="tag">{experience.title}</span><h3>{experience.organization}</h3><p class="experience-period">{experience.period}</p><ul>{experience.bullets.map(bullet => <li>{bullet}</li>)}</ul><a class="text-link" href={experience.link} target="_blank" rel="noreferrer">View project ↗</a></article><article class="card education-card"><span class="tag">Education</span><h3>Bachelor of Science in Computer Science</h3><div class="education-meta"><p><span>University</span><strong>Imam Abdulrahman Bin Faisal University (IAU)</strong></p><p><span>Honors</span><strong>Second-Class Honors</strong></p><p><span>GPA</span><strong>4.44/5.00</strong></p></div></article></div></section>

  <section id="skills"><h2>The <mark>stack</mark></h2><div class="stack-groups">{Object.entries(skills).map(([group, items]) => <div class="stack-group"><h3>{group}</h3><div class="sk">{items.map(item => <span>{item}</span>)}</div></div>)}</div></section>

  <section class="end" id="contact"><h2>Let’s build something useful.</h2><p>{copy.en.contactText}</p><div class="contact-actions"><a class="btn" href={`mailto:${profile.email}`}>{profile.email}</a><a class="btn" href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a><a class="btn" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a><a class="btn" href={profile.cv} download>Download CV ↓</a></div></section>
</Layout>
