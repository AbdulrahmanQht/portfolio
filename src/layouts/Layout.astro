---
import '../styles/global.css';
import { profile, copy, type Locale } from '../content/site';
const { locale = 'en', title = `${locale === 'ar' ? 'عبدالرحمن القحطاني' : profile.shortName} | ${locale === 'ar' ? 'مطور Full-Stack وAI/ML' : profile.role}` } = Astro.props;
const t = copy[locale as Locale];
const isArabic = locale === 'ar';
const pathWithoutLocale = Astro.url.pathname.replace(/^\/(en|ar)/, '') || '/';
const alternate = `/${isArabic ? 'en' : 'ar'}${pathWithoutLocale}`;
const siteUrl = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, '');
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const alternateUrl = `${siteUrl}${alternate}`;
const pageDescription = t.summary;
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: siteUrl,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Dammam', addressCountry: 'SA' },
  sameAs: [profile.github, profile.linkedin]
};
---
<!doctype html>
<html lang={locale} dir={isArabic ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f4efe6" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={locale} href={canonicalUrl} />
    <link rel="alternate" hreflang={isArabic ? 'en' : 'ar'} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/en${pathWithoutLocale}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.shortName} />
    <meta property="og:locale" content={isArabic ? 'ar_SA' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline>try{const v=localStorage.getItem('theme');const dark=v||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');if(dark==='dark')document.documentElement.dataset.t='dark'}catch(e){}</script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{isArabic ? 'تخطَّ إلى المحتوى' : 'Skip to content'}</a>
    <div class="w">
      <header class="top"><a class="logo" href={`/${locale}/`} aria-label={isArabic ? 'عبدالرحمن القحطاني' : profile.shortName}>{isArabic ? 'عبدالرحمن القحطاني' : profile.shortName}</a><nav class="nav" aria-label={isArabic ? 'التنقل الرئيسي' : 'Primary navigation'}><a class="btn" href={`/${locale}/#projects`}>{t.nav.projects}</a><a class="btn" href={`/${locale}/#experience`}>{t.nav.experience}</a><a class="btn" href={`/${locale}/#skills`}>{t.nav.skills}</a><a class="btn" href={profile.cv} download>{t.download}</a><button class="btn" id="th" type="button" aria-label={isArabic ? 'تبديل المظهر' : 'Toggle theme'} data-theme-toggle>☾</button><a class="btn" id="lg" href={alternate}>{isArabic ? 'EN' : 'عربي'}</a></nav></header>
      <main id="main-content"><slot /></main>
      <footer class="site-footer"><span>© {new Date().getFullYear()} {profile.shortName}</span><span>{isArabic ? t.locationText : profile.location}</span><a href={`mailto:${profile.email}`}>{profile.email}</a><a href={alternate}>{isArabic ? 'English' : 'العربية'}</a></footer>
    </div>
    <script is:inline>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click',(event)=>{const n=document.documentElement.dataset.t==='dark'?'light':'dark';if(n==='dark')document.documentElement.dataset.t='dark';else delete document.documentElement.dataset.t;localStorage.setItem('theme',n);if(event.currentTarget instanceof HTMLElement)event.currentTarget.textContent=n==='dark'?'☀':'☾'});
    </script>
  </body>
</html>
