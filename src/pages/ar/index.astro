---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { profile, skills, experience, projects, copy } from '../../content/site';
const t = copy.ar;
---
<Layout locale="ar">
  <section class="hero section-wrap" id="profile"><div class="hero-copy"><p class="eyebrow">ملف / 001 · متاح للتعاون</p><h1>{profile.name}</h1><p class="role">{profile.role}</p><p class="lede">{t.intro}</p><p class="summary">{t.summary}</p><div class="hero-links"><a class="button button-primary" href={profile.cv} download>{t.download} ↓</a><a class="text-link" href={`mailto:${profile.email}`}>Email ↗</a><a class="text-link" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a><a class="text-link" href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a></div></div><aside class="file-card"><span class="stamp">مُعتمد</span><div class="file-card-body"><span class="eyebrow">الموقع</span><strong>{profile.location}</strong><span class="eyebrow">مجالات التركيز</span><strong>Full-stack systems<br />Applied AI / ML</strong><span class="file-rule"></span><small>المعلومات مستندة إلى السيرة الذاتية والمستودعات العامة.</small></div></aside></section>
  <section class="section-wrap" id="skills"><div class="section-heading"><span class="section-kicker">02 / STACK</span><h2>{t.labels.skills}</h2></div><div class="skills-grid">{Object.entries(skills).map(([group, items]) => <div class="skill-group"><h3>{group}</h3><div class="tags">{items.map(item => <span>{item}</span>)}</div></div>)}</div></section>
  <section class="section-wrap" id="projects"><div class="section-heading"><span class="section-kicker">03 / PROJECTS</span><h2>{t.labels.projects}</h2><p>ثمانية مستودعات في أرشيف واحد. افتح ملفاً مميزاً لاستعراض المعمارية والأدلة.</p></div><div class="projects-grid">{projects.map((project, index) => <ProjectCard project={project} locale="ar" labels={{ viewCase: t.viewCase, viewRepo: t.viewRepo, liveDemo: t.liveDemo }} projectsIndex={index + 1} />)}</div></section>
  <section class="section-wrap split-section" id="experience"><div><div class="section-heading"><span class="section-kicker">04 / EXPERIENCE</span><h2>{t.labels.experience}</h2></div><article class="timeline-card"><span class="eyebrow">{experience.period}</span><h3>{experience.title}</h3><p>{experience.organization}</p><ul>{experience.bullets.map(bullet => <li>{bullet}</li>)}</ul><a class="text-link" href={experience.link} target="_blank" rel="noreferrer">Project repository ↗</a></article></div><div class="education-card"><span class="eyebrow">{t.labels.education}</span><h3>Bachelor of Science in Computer Science</h3><p>{t.education}</p><span class="degree-note">سيتم إضافة تواريخ التعليم بعد تأكيد المالك.</span></div></section>
  <section class="contact-section section-wrap" id="contact"><div><span class="section-kicker">05 / CONTACT</span><h2>{t.labels.contact}</h2><p>{t.contactText}</p></div><div class="contact-links"><a href={`mailto:${profile.email}`}><span>{t.labels.email}</span><strong>{profile.email}</strong></a><a href={profile.linkedin} target="_blank" rel="noreferrer"><span>LinkedIn</span><strong>/abdulrahmanqht ↗</strong></a><a href={profile.github} target="_blank" rel="noreferrer"><span>GitHub</span><strong>/AbdulrahmanQht ↗</strong></a></div></section>
</Layout>
