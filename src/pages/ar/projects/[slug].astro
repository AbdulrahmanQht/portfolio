---
import Layout from '../../../layouts/Layout.astro';
import { projects } from '../../../content/site';
export function getStaticPaths() { return projects.filter(p => p.featured).map(project => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const arCopy: Record<string, { eyebrow: string; description: string; sections: Record<string, string> }> = {
  'tracepilot-ai': { eyebrow: 'مميز / أنظمة متعددة الوكلاء', description: 'منصة متعددة الوكلاء تدقق في آثار تنفيذ وكلاء البرمجة باستخدام التحقق الأعمى من النتائج وتتبع الموثوقية عبر الحالة.', sections: { Problem: 'يحتاج المطورون إلى دليل يثبت أن ادعاء وكيل البرمجة بإتمام المهمة يطابق ما حدث فعلياً في أثر التنفيذ.', Architecture: 'ترسل واجهة React الآثار إلى منسق Spring Boot، الذي يحفظ المهام ويرسلها بشكل غير متزامن عبر RabbitMQ إلى عامل FastAPI وCrewAI. تحفظ PostgreSQL عمليات التدقيق وتستقبل Jaeger آثار التتبع الموزعة.', Role: 'صممت بنية الخدمات المصغرة متعددة لغات البرمجة، وخط تدقيق المهام غير المتزامن، وتقارير الموثوقية، والمراقبة، ولوحة React.', Evidence: 'يشمل المشروع اختبارات عزل مطالبات المتحقق الأعمى، وعمليات التدقيق غير المتزامنة متعددة الوكلاء، وتقارير الموثوقية المعتمدة على الحالة، والتتبع الموزع، ومخرجات التدقيق القابلة للمشاركة.' } },
  'quantum-hybrid-defect-detector': { eyebrow: 'مميز / مشروع التخرج', description: 'تطبيق متكامل لتصنيف العيوب الصناعية يقارن بين مسارات الاستدلال باستخدام الشبكات العصبية الالتفافية (CNN) والهجينة الكمومية-الكلاسيكية.', sections: { Problem: 'يحتاج تصنيف العيوب الصناعية إلى طريقة متسقة لمقارنة الاستدلال التقليدي والهجين الكمومي-الكلاسيكي مع المدخلات النظيفة والمشوشة.', Architecture: 'تتصل واجهة Vue 3 الثنائية اللغة، مع لوحات المعلومات، بخادم FastAPI. يحمّل الخادم نماذج CNN وQNN_CPU وQNN_GPU المشروطة بدعم CUDA، ويوفر مسارات للتصنيف والمقارنة والأفضلية الكمومية.', Role: 'قدت جانب البرمجة في نظام الدمج الهجين، والخادم عديم الحالة، وتسخين النماذج، وتحديد المعدل، وترويسات الأمان، وتطبيق Vue أحادي الصفحة.', Results: 'على 2,833 صورة اختبار، حقق QNN_GPU أفضل نتيجة بدقة 95.59% وmacro F1 قدره 95.67%، مقابل 93.47% و93.70% لـCNN.' } },
  'vpaa-gate': { eyebrow: 'مميز / مشروع التدريب التعاوني', description: 'منصة جامعية داخلية لإدارة بيانات الكليات باستخدام ASP.NET MVC 5 وOracle وDapper وبنية متعددة الطبقات.', sections: { Problem: 'احتاجت إجراءات الشؤون الأكاديمية إلى منصة داخلية منظمة لبيانات الكليات والصلاحيات المحددة ولوحات المعلومات.', Architecture: 'توجه طبقة Web الطلبات إلى خدمات Logic ومستودعات DataAccess، بينما توجد الكيانات وDTOs المشتركة في طبقة Model.', Role: 'قدت التصميم المعماري والتنفيذ والتحكم في الصلاحيات والواجهة الثنائية اللغة وأتمتة الإجراءات وتحليل الأداء ومراجعات الشيفرة والتحكم في الإصدارات خلال التدريب التعاوني.', Evidence: 'قدّم التنفيذ منصة ASP.NET MVC 5 بصلاحيات RBAC محددة وواجهة ثنائية اللغة وإجراءات مجدولة عبر Oracle DBMS_SCHEDULER وتحليل MiniProfiler ولوحات ApexCharts خلال مشروع التدريب التعاوني.' } }
};
const localized = arCopy[project.slug];
const arLabels: Record<string, string> = { Problem: 'المشكلة', Architecture: 'البنية', Role: 'الدور', Results: 'النتائج', Evidence: 'الأدلة' };
---
<Layout locale="ar" title={`${project.title} | عبدالرحمن القحطاني`}><section class="case-hero section-wrap"><div class="case-nav"><a class="back-link" href="/ar/#projects">→ العودة إلى ملفات المشاريع</a></div><span class="eyebrow">{localized?.eyebrow ?? project.eyebrow}</span><h1>{project.title}</h1><p class="lede">{localized?.description ?? project.description}</p><div class="tags">{project.stack.map(item => <span>{item}</span>)}</div><div class="hero-links"><a class="button button-primary" href={project.repo} target="_blank" rel="noreferrer">GitHub ↖</a></div></section><section class="case-body section-wrap">{project.sections?.map(section => <article><h2>{arLabels[section.label] ?? section.label}</h2><p>{localized?.sections[section.label] ?? section.text}</p></article>)}</section></Layout>
